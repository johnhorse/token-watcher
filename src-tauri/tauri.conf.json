{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token-watcher",
  "version": "0.1.0",
  "identifier": "io.github.johnhorse.token-watcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "token-watcher",
        "width": 380,
        "height": 560,
        "resizable": false
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-template.png",
      "iconAsTemplate": true
    },
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": null
    }
  }
}